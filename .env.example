# Секреты для docker compose. Скопируйте в .env (он не попадает в git) и задайте свои значения:
#   cp .env.example .env
# Сгенерировать: openssl rand -base64 32

# Подпись котировок: общий секрет pricing и payment
QUOTE_SECRET=
# account: HMAC номеров карт (поиск, защита от повторной привязки)
CARD_HMAC_KEY=
# account: шифрование номеров карт AES-256 — ровно 32 байта в base64 (openssl rand -base64 32)
CARD_ENCRYPTION_KEY=

# Сборка образов: токен GitHub с правом read:packages — Maven скачивает общую библиотеку payments-platform
# из GitHub Packages. Можно не задавать: scripts/up.sh возьмёт его из gh (gh auth token)
GITHUB_TOKEN=
